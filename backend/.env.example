# Copy this file to .env and adjust for your machine.
# Comma-separated list of extra frontend origins allowed to call this API
# (localhost:5173/4173 are already allowed by default). Add your teammate's
# actual Vite dev URL here, e.g. their LAN IP:
FRONTEND_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=commerceiq-ai
DATABASE_URL=sqlite:////data/ecommerce.db

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
