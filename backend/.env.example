# Backend environment configuration
APP_ENV=development

# Comma-separated list of extra frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173

# Firebase Authentication Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: Path to Google Service Account JSON file (if using explicit service account credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# LLM / GitHub Models Configuration for Chatbot
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
GITHUB_MODELS_ENDPOINT=https://models.github.ai/inference
